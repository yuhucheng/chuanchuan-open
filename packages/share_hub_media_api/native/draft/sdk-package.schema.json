{
  "type": "object",
  "properties": {
    "schema": {
      "const": "sharehub-sdk-package-draft-1"
    },
    "exampleOnly": {
      "type": "boolean"
    },
    "inventoryComplete": {
      "type": "boolean"
    },
    "artifactId": {
      "$ref": "#/$defs/artifactId"
    },
    "kind": {
      "enum": [
        "native",
        "flutter"
      ]
    },
    "sdkVersion": {
      "$ref": "#/$defs/version"
    },
    "productTarget": {
      "$ref": "#/$defs/version"
    },
    "channel": {
      "enum": [
        "internal-candidate",
        "release"
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "apiCompatibility": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/api"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "nativeAbi": {
      "oneOf": [
        {
          "$ref": "#/$defs/draftAbi"
        },
        {
          "$ref": "#/$defs/stableAbi"
        }
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/features"
    },
    "signing": {
      "$ref": "#/$defs/signing"
    },
    "licenseFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "minItems": 2,
      "maxItems": 1024,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "licenses/LICENSE.sdk.txt"
          }
        },
        {
          "contains": {
            "const": "licenses/THIRD_PARTY_NOTICES.txt"
          }
        }
      ]
    },
    "validationFile": {
      "const": "metadata/validation.json"
    },
    "publicSnapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      },
      "minItems": 0,
      "maxItems": 2
    },
    "nativePayload": {
      "$ref": "#/$defs/nativePayload"
    },
    "files": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/file"
          },
          {
            "$ref": "#/$defs/symlink"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 65536
    }
  },
  "required": [
    "schema",
    "exampleOnly",
    "inventoryComplete",
    "artifactId",
    "kind",
    "sdkVersion",
    "productTarget",
    "channel",
    "target",
    "apiCompatibility",
    "nativeAbi",
    "capabilities",
    "signing",
    "licenseFiles",
    "validationFile",
    "publicSnapshots",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chuanchuan:sdk-package:review-draft-1",
  "title": "SDK package manifest complete field shape (review draft 1)",
  "description": "Field shape only. Does not verify binary ABI, bytes, signatures, license review or installation. Stable ABI and release fields are review proposals, not implemented runtime support.",
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)(?![\\s\\S])"
    },
    "osVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 43,
      "pattern": "^(?:(?:0|[1-9][0-9]{0,9})(?:\\.(?:0|[1-9][0-9]{0,9})){1,3})(?![\\s\\S])"
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[a-z][a-z0-9-]{0,63})(?![\\s\\S])"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:[a-z0-9][a-z0-9.-]{0,127})(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)(?![\\s\\S])"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "target": {
      "type": "object",
      "properties": {
        "os": {
          "enum": [
            "windows",
            "macos"
          ]
        },
        "architectures": {
          "type": "array",
          "items": {
            "enum": [
              "arm64",
              "x86_64"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "minimumOs": {
          "anyOf": [
            {
              "$ref": "#/$defs/osVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "runtimeInspectionComplete": {
          "type": "boolean"
        }
      },
      "required": [
        "os",
        "architectures",
        "minimumOs",
        "runtimeDependencies",
        "runtimeInspectionComplete"
      ],
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "package": {
          "enum": [
            "share_hub_media_api",
            "share_hub_session_api"
          ]
        },
        "minInclusive": {
          "$ref": "#/$defs/version"
        },
        "maxExclusive": {
          "$ref": "#/$defs/version"
        },
        "testedVersions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "package",
        "minInclusive",
        "maxExclusive",
        "testedVersions"
      ],
      "additionalProperties": false
    },
    "draftAbi": {
      "type": "object",
      "properties": {
        "family": {
          "const": "sharehub-media-c"
        },
        "stability": {
          "const": "draft"
        },
        "draftRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "requiredFeatures": {
          "$ref": "#/$defs/features"
        }
      },
      "required": [
        "family",
        "stability",
        "draftRevision",
        "requiredFeatures"
      ],
      "additionalProperties": false
    },
    "stableAbi": {
      "type": "object",
      "properties": {
        "family": {
          "const": "sharehub-media-c"
        },
        "stability": {
          "const": "stable"
        },
        "major": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "requiredFeatures": {
          "$ref": "#/$defs/features"
        }
      },
      "required": [
        "family",
        "stability",
        "major",
        "minor",
        "requiredFeatures"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "type": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 17179869184
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "path",
        "role",
        "sizeBytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "symlink": {
      "type": "object",
      "properties": {
        "type": {
          "const": "symlink"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "type",
        "path",
        "role",
        "target"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "package": {
          "enum": [
            "share_hub_media_api",
            "share_hub_session_api"
          ]
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "directory": {
          "$ref": "#/$defs/path"
        },
        "publicRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "package",
        "version",
        "directory",
        "publicRevision",
        "sourceDigest"
      ],
      "additionalProperties": false
    },
    "nativePayload": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/artifactId"
        },
        "directory": {
          "enum": [
            "native/windows-x64",
            "native/windows-arm64",
            "native/macos-universal"
          ]
        },
        "manifestSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "artifactId",
        "directory",
        "manifestSha256"
      ],
      "additionalProperties": false
    },
    "signing": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "unsigned",
            "ad-hoc",
            "signed",
            "notarized"
          ]
        },
        "reportPath": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reportPath"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "native"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "nativePayload"
          ]
        },
        "properties": {
          "publicSnapshots": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "required": [
          "nativePayload"
        ],
        "properties": {
          "publicSnapshots": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exampleOnly": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "inventoryComplete": {
            "const": false
          },
          "channel": {
            "const": "internal-candidate"
          }
        }
      },
      "else": {
        "properties": {
          "inventoryComplete": {
            "const": true
          },
          "target": {
            "properties": {
              "minimumOs": {
                "$ref": "#/$defs/osVersion"
              }
            }
          },
          "files": {
            "items": {
              "if": {
                "properties": {
                  "type": {
                    "const": "file"
                  }
                }
              },
              "then": {
                "properties": {
                  "sizeBytes": {
                    "type": "integer"
                  },
                  "sha256": {
                    "$ref": "#/$defs/hash"
                  }
                }
              }
            }
          },
          "publicSnapshots": {
            "items": {
              "properties": {
                "publicRevision": {
                  "$ref": "#/$defs/revision"
                },
                "sourceDigest": {
                  "$ref": "#/$defs/hash"
                }
              }
            }
          },
          "nativePayload": {
            "properties": {
              "manifestSha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "os": {
                "const": "windows"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "architectures": {
                "maxItems": 1
              }
            }
          },
          "files": {
            "items": {
              "properties": {
                "type": {
                  "const": "file"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "properties": {
              "architectures": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "release"
          }
        }
      },
      "then": {
        "properties": {
          "exampleOnly": {
            "const": false
          },
          "nativeAbi": {
            "$ref": "#/$defs/stableAbi"
          },
          "target": {
            "properties": {
              "runtimeInspectionComplete": {
                "const": true
              }
            }
          },
          "signing": {
            "properties": {
              "status": {
                "enum": [
                  "signed",
                  "notarized"
                ]
              },
              "reportPath": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "os": {
                "const": "windows"
              },
              "architectures": {
                "const": [
                  "x86_64"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "nativePayload": {
            "properties": {
              "directory": {
                "const": "native/windows-x64"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "os": {
                "const": "windows"
              },
              "architectures": {
                "const": [
                  "arm64"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "nativePayload": {
            "properties": {
              "directory": {
                "const": "native/windows-arm64"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "os": {
                "const": "macos"
              },
              "architectures": {
                "const": [
                  "arm64",
                  "x86_64"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "nativePayload": {
            "properties": {
              "directory": {
                "const": "native/macos-universal"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "os": {
                "const": "macos"
              },
              "architectures": {
                "const": [
                  "x86_64",
                  "arm64"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "nativePayload": {
            "properties": {
              "directory": {
                "const": "native/macos-universal"
              }
            }
          }
        }
      }
    }
  ]
}
